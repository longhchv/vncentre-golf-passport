// Cấu hình Cloudflare Workers (static assets) cho bản web.
// Build: npm run build → thư mục dist. Mọi đường dẫn không phải file tĩnh đều trả index.html (SPA).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vncentre-golf-passport",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
